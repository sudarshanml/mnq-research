# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit real keys.

# ── OpenAI (TrendAgent: GPT-4o) ──────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google (MeanRevertAgent: Gemini 2.5 Flash) ───────────────────────────
GOOGLE_API_KEY=AIza...

# ── Anthropic / Claude (RiskAgent: Sonnet  +  Chair: Opus) ───────────────
#
# Option A — Claude Pro/Max subscription (no API key needed):
#   1. Install Claude Code CLI:
#        npm install -g @anthropic-ai/claude-code
#   2. Log in with your Anthropic account (one-time):
#        claude auth login
#   3. Install and start the proxy (keep running alongside the app):
#        npm install -g claude-max-api-proxy
#        claude-max-api          # listens on http://localhost:3456
#   4. Set this line:
CLAUDE_PROXY_URL=http://localhost:3456/v1
#
# Option B — Direct Anthropic API key (pay-per-token):
# ANTHROPIC_API_KEY=sk-ant-...
#
# If neither is set, RiskAgent and Chair fall back to GPT-4o automatically.

# ── Optional: override Claude model names the proxy exposes ───────────────
# PROXY_SONNET_MODEL=claude-sonnet-4-6
# PROXY_OPUS_MODEL=claude-opus-4-6
